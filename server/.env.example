# 复制本文件为 .env 并填入实际值（.env 不要提交到公开仓库）
# 所有变量均为可选，不填则使用默认值（自助注册模式 + 无AI回退模板）

# ===== 服务端口 =====
PORT=3000

# ===== 会话签名密钥（留空会自动随机生成；生产环境务必设置一个固定随机串）=====
SECRET=

# ===== 管理员密钥：用于发放教师登录密钥 =====
# 设置后，可调用 POST /api/admin/issue 批量生成教师密钥（见 README）
ADMIN_KEY=

# ===== AI 代理（读取服务端 key，老师端无感调用，key 不暴露）=====
# 留空：前端调用 AI 时自动回退到内置模板生成（完全免费）
# 推荐免费/低价平台：硅基流动 https://siliconflow.cn 或 DeepSeek 开放平台
AI_KEY=
# API 地址（OpenAI 兼容格式）
AI_BASE=https://api.siliconflow.cn/v1
# 模型名（硅基流动示例；DeepSeek 可用 deepseek-chat）
AI_MODEL=deepseek-ai/DeepSeek-V3

# ===== 是否允许任意密钥自助注册新空间 =====
# true（默认）：任何密钥首次登录自动建独立空间（开发/演示方便）
# false：只有你预置在 server/data/keys.json 中的密钥才能登录
ALLOW_SELF_REGISTER=true

# ===== 云端数据库（部署到 Render 等临时文件系统环境时必须配置）=====
# Render 免费层文件系统会在重启/重新部署时清空，本地 JSON 会丢，故需接外部库。
# 不填：自动回退本地文件 data/（仅适合本地开发或文件系统持久化的主机）。
# 填写后：改用 Supabase（PostgreSQL 免费额度）做云端存储，多用户数据持久化。
# 获取方式：登录 supabase.com 新建项目 → 项目设置 → API → 复制 Project URL 与 anon/public key
# 建表：把同目录 SUPABASE_SETUP.sql 的内容在 Supabase SQL Editor 执行一次
SUPABASE_URL=
SUPABASE_KEY=
# 表名（一般不用改，需与 SUPABASE_SETUP.sql 中一致）
SUPABASE_TABLE=kv

# ===== 跨域来源（对接 CloudStudio 等独立静态前端时填其域名；留空默认 * 允许任意来源）=====
CORS_ORIGIN=
